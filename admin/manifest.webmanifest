{
  "name": "קלפי שירים · ניהול",
  "short_name": "ניהול שירים",
  "description": "מוסיפים שירים ואת הביצוע שלנו, ומדפיסים קלפים",
  "lang": "he",
  "dir": "rtl",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5EEE1",
  "theme_color": "#F5EEE1",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", "video/*", ".opus", ".ogg", ".oga", ".m4a", ".mp3", ".aac", ".wav", ".amr", ".3gp", ".mp4", ".webm"]
        }
      ]
    }
  }
}
